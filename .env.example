# URL de la boutique, sans /api final. HTTPS est requis hors localhost.
SHOPWARE_URL=https://shop.example.com
# Créez une intégration administrateur dans Paramètres > Système > Intégrations.
SHOPWARE_CLIENT_ID=your-access-key-id
SHOPWARE_CLIENT_SECRET=your-secret-access-key
# Facultatif : un Bearer token déjà obtenu. Prioritaire sur client id/secret.
# SHOPWARE_ACCESS_TOKEN=

# Important : API access key d'un canal de vente = Store API uniquement.
# Elle ne permet pas l'administration et ne doit pas remplacer les identifiants Admin API ci-dessus.

# Mode HTTP pour PM2/reverse proxy (le mode stdio est la valeur par défaut).
# MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=3000
# Générer avec : openssl rand -hex 32
# MCP_BEARER_TOKEN=

# OAuth 2.1/OIDC pour ChatGPT (à préférer en production).
# MCP_AUTH_MODE=oauth
# MCP_PUBLIC_URL=https://mcp.example.com
# OAUTH_ISSUER=https://id.example.com/realms/shopware
# OAUTH_AUDIENCE=https://mcp.example.com
# OAUTH_SCOPES=shopware:admin
